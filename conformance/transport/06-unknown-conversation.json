{
  "name": "unknown conversation",
  "description": "Only the transport issues conversation IDs. A message for an ID it did not issue is rejected with 404 and runs nothing; the conversation it did issue is unaffected.",
  "agent": {
    "name": "conformance-agent",
    "version": "1.0.0",
    "model": "scripted",
    "instructions": "Follow the script."
  },
  "tools": [],
  "model_script": [
    [
      {
        "text": "One."
      }
    ],
    [
      {
        "text": "Two."
      }
    ]
  ],
  "requests": [
    {
      "conversation_id": "c1",
      "body": {
        "message_id": "m1",
        "text": "Hello"
      },
      "expect": {
        "status": 404
      }
    },
    {
      "conversation": "A",
      "body": {
        "message_id": "m1",
        "text": "First"
      },
      "expect": {
        "status": 201,
        "events": [
          {
            "type": "token",
            "data": {
              "text": "One."
            }
          },
          {
            "type": "turn_done",
            "data": {
              "stop_reason": "end_turn"
            }
          }
        ]
      }
    },
    {
      "conversation_id": "not-the-id-that-was-issued",
      "body": {
        "message_id": "m2",
        "text": "Second"
      },
      "expect": {
        "status": 404
      }
    },
    {
      "conversation": "A",
      "body": {
        "message_id": "m2",
        "text": "Second"
      },
      "expect": {
        "status": 200,
        "events": [
          {
            "type": "token",
            "data": {
              "text": "Two."
            }
          },
          {
            "type": "turn_done",
            "data": {
              "stop_reason": "end_turn"
            }
          }
        ]
      }
    }
  ]
}
