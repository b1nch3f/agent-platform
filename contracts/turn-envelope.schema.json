{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "turn-envelope.schema.json",
  "title": "TurnEnvelope",
  "description": "One inbound turn, normalized by the transport from any protocol. See docs/design/03-transport.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "conversation_id",
    "protocol",
    "identity",
    "kind",
    "payload"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1,
      "description": "Client-generated; deduplicates double-sends."
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Issued by the transport when the conversation starts."
    },
    "protocol": {
      "enum": [
        "websocket",
        "http_sse",
        "a2a",
        "kafka",
        "local"
      ],
      "description": "'local' is an in-process turn with no network protocol, as in the terminal chat."
    },
    "identity": {
      "$ref": "#/$defs/CallIdentity"
    },
    "kind": {
      "enum": [
        "message",
        "decision",
        "cancel"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Text and attachments, or action_id and decision."
    },
    "a2a_task_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "$defs": {
    "CallIdentity": {
      "title": "CallIdentity",
      "description": "The user or calling agent, and its tenant.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "user_id"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
